NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/society_management?replicaSet=rs0
JWT_ACCESS_SECRET=change-me-access-secret-min-16-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-16-chars
EXPOSE_DEV_OTP=true
CORS_ORIGINS=*
ENABLE_TRANSACTIONS=true
PAYMENT_GATEWAY=mock
PAYMENT_WEBHOOK_SECRET=dev-payment-secret
OTP_LENGTH=6
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_SECONDS=30
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000
AUTH_RATE_LIMIT_MAX=40
MAX_UPLOAD_MB=5
SCHEDULER_ENABLED=true
SUPER_ADMIN_NAME=Platform Owner
SUPER_ADMIN_EMAIL=superadmin@example.com
SUPER_ADMIN_MOBILE=+919999999999
SUPER_ADMIN_PASSWORD=ChangeMe@123

# Push notifications — optional; push disabled when unset (see docs/PUSH_NOTIFICATIONS.md)
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=
FCM_SERVICE_ACCOUNT_JSON=
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_PRIVATE_KEY=
APNS_BUNDLE_ID=com.habitoliving.habito
APNS_USE_SANDBOX=true
PUSH_STRICT=false
